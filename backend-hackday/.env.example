# Neon: Dashboard > Connect > pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public URL of this API (NOT the Next.js port)
BETTER_AUTH_URL=http://localhost:4000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the Next.js app (CORS + trusted origin)
FRONTEND_URL=http://localhost:3000
PORT=4000

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL: http://localhost:4000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Gemini (key from https://aistudio.google.com/apikey). Backend/worker only, never NEXT_PUBLIC_.
GEMINI_API_KEY=
# Cheapest/fastest; supports tool calling, structured output, Search grounding (paid key only). Upgrade path: gemini-4-hydrogen
GEMINI_MODEL=gemini-3.5-flash-lite
# Google Search grounding is NOT available on the free tier; set true only on a paid key
GEMINI_SEARCH_ENABLED=false

# GitHub App (repo access + PRs), https://github.com/settings/apps. Separate from the login OAuth app above.
# Install callback / OAuth redirect: http://localhost:4000/api/v1/github/installations/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents on ONE line with literal \n between lines, wrapped in double quotes
GITHUB_APP_PRIVATE_KEY=
# openssl rand -hex 32 (set the same value on the GitHub App's webhook settings)
GITHUB_WEBHOOK_SECRET=

# --- Worker / pipeline (all optional) ---
# Separate process: `bun run worker`. Health: http://localhost:4100
WORKER_CONCURRENCY=3
WORKER_HEALTH_PORT=4100
# Max packages the AI investigates per analysis (rest keep deterministic advisory data)
INVESTIGATION_LIMIT=6
GEMINI_MAX_CONCURRENCY=3
# How often the worker re-checks advisories for connected repositories
ADVISORY_REFRESH_MINUTES=360
# NVD API key raises NVD rate limits (optional)
NVD_API_KEY=

# --- Email (Resend). Without a key, deliveries are logged as "skipped" ---
RESEND_API_KEY=
EMAIL_FROM=RepoSec <onboarding@resend.dev>
